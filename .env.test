# Bun loads this file into every `bun test` process that starts in the
# repository root, as each test runner does. So no git command that a test
# starts reads the global or the system git configuration of the person who
# runs the tests.
#
# A global `trace2.eventTarget`, such as the one a Git AI daemon installs, sends
# each git command to a background service. That service then writes into the
# repository, and it can do so after the test removed its temporary repository.
# The write creates the repository again, and the run fails on the leftover
# TMPDIR entry although every test passed.
#
# A launch that names no environment gets the environment its Bun process
# started with, not the current `process.env`. So only this file reaches every
# launch in the process; a test or preload that sets these variables does not.
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_NOSYSTEM=1
FLYWHEEL_TEST_SUPPRESS_AUTO_DIALOGS=1

# A child that imports src/ without configuring a log sink must not open the
# person's account log. This also reaches launches with no explicit environment.
FLYWHEEL_UNCONFIGURED_LOG=drop
