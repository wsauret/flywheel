{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "flywheel-remote-app",
  "compatibility_date": "2026-08-27",
  "routes": [{ "pattern": "remote.flywl.sh", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
