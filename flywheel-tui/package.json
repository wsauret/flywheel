{
  "name": "flywheel-tui",
  "version": "0.0.1",
  "type": "module",
  "main": "src/orchestration/cli/index.ts",
  "bin": {
    "flywheel": "bin/flywheel"
  },
  "scripts": {
    "dev": "bun --conditions=browser run src/orchestration/cli/index.ts",
    "start": "bun --conditions=browser run src/orchestration/cli/index.ts",
    "test": "bun test tests/*.test.ts",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/",
    "test:all": "bun test",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "bun run scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@ast-grep/napi": "^0.42.0",
    "@opencode-ai/sdk": "^1.2.27",
    "@opentui/core": "^0.1.0",
    "@opentui/solid": "^0.1.0",
    "fuzzysort": "^3.1.0",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.8",
    "solid-js": "^1.9.0",
    "yargs": "^17.7.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/yargs": "^17.0.33"
  }
}
