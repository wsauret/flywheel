{
  "name": "flywheel-tui",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "src/cli/index.ts",
  "bin": {
    "flywheel": "bin/flywheel"
  },
  "workspaces": [
    "relay",
    "vscode",
    "webview",
    "website"
  ],
  "scripts": {
    "dev": "bun --conditions=browser run scripts/dev.ts",
    "start": "bun --conditions=browser run scripts/dev.ts",
    "test": "bun run scripts/test-parallel.ts",
    "test:coverage": "bun run scripts/test-coverage.ts",
    "test:verbose": "bun test tests/unit",
    "test:ripgrep-native": "cargo test --manifest-path crates/ripgrep/Cargo.toml",
    "test:integration:no-api": "bun run scripts/test-integration.ts no-api",
    "test:integration:api": "bun run scripts/test-integration.ts api",
    "test:integration:claude-engine": "bun run scripts/test-integration.ts claude-engine",
    "test:integration:all": "bun run scripts/test-integration.ts all",
    "test:modules": "bun test tests/unit/infra/module-regression.test.ts tests/unit/orchestration/config/config-module-settings-persistence.test.ts tests/unit/orchestration/config/module-policy.test.ts tests/unit/orchestration/agent-runtime/request-tool-surface.test.ts tests/unit/orchestration/agent-runtime/runner-capabilities.test.ts tests/unit/orchestration/agent-runtime/tools/tool-exposure-contract.test.ts tests/unit/orchestration/agent-runtime/tools/tool-exposure-planner.test.ts tests/unit/orchestration/app-service/definition-availability.test.ts tests/unit/orchestration/app-service/model-assignment-service.test.ts tests/unit/orchestration/module-complete-off.test.ts tests/integration/orchestration/modules.test.ts tests/integration/orchestration/config-watch.test.ts",
    "test:output-seam": "bun test tests/unit/orchestration/app-service/output-projection.test.ts tests/unit/orchestration/app-service/output-projection-child-cards.test.ts tests/unit/orchestration/app-service/transcript-protocol.test.ts tests/integration/output-seam-corpus.test.ts tests/unit/orchestration/app-service/output-live-derived-equivalence.test.ts",
    "test:e2e": "bash tests/e2e/tui-run-all.sh",
    "test:experiment-finalize": "bash tests/integration/orchestration/modules/experiments/finalize-test.sh",
    "test:experiment-integrity": "bun test tests/unit/orchestration/modules/experiments/tools/init-experiment.test.ts tests/unit/orchestration/modules/experiments/tools/run-experiment.test.ts tests/unit/orchestration/modules/experiments/tools/log-experiment.test.ts tests/unit/orchestration/modules/experiments/state-reconstruction.test.ts tests/unit/orchestration/modules/experiments/projection.test.ts tests/unit/orchestration/modules/experiments/operation-owner.test.ts tests/unit/orchestration/modules/experiments/git-settlement.test.ts tests/unit/orchestration/modules/experiments/git-operations.test.ts tests/unit/orchestration/modules/experiments/experiment-command.test.ts tests/unit/orchestration/modules/experiments/chat-runtime-persistence.test.ts tests/integration/orchestration/modules/experiments/git-operations.test.ts",
    "test:uat": "bun test tests/unit/scripts/uat/harness.test.ts && bun test tests/integration/scripts/uat",
    "uat:tui": "bun run scripts/uat/tui.ts",
    "test:release": "bun run tests/release/run.ts",
    "test:e2e:tui-chat": "bash tests/e2e/tui-chat.sh",
    "test:all": "bun run test && bun run test:integration:all",
    "build": "bun run scripts/build.ts",
    "build:tokenizer": "bun run scripts/build-tokenizer.ts",
    "build:macos-launcher": "bun run scripts/build-macos-launcher.ts",
    "build:windows-launcher": "bun run scripts/build-windows-launcher.ts",
    "build:windows-git-forwarder": "bun run scripts/build-windows-git-forwarder.ts",
    "build:ripgrep": "bun run scripts/build-ripgrep.ts",
    "build:ripgrep:linux-x64": "bun run scripts/build-ripgrep.ts --target=bun-linux-x64",
    "build:ripgrep:linux-arm64": "bun run scripts/build-ripgrep.ts --target=bun-linux-arm64",
    "build:ripgrep:windows-x64": "bun run scripts/build-ripgrep.ts --target=bun-windows-x64",
    "build:ripgrep:windows-arm64": "bun run scripts/build-ripgrep.ts --target=bun-windows-arm64",
    "build:binary": "bun run scripts/build-binary.ts",
    "build:binary:linux-x64": "bun run scripts/build-binary.ts --target=bun-linux-x64",
    "build:binary:linux-arm64": "bun run scripts/build-binary.ts --target=bun-linux-arm64",
    "build:binary:windows-x64": "bun run scripts/build-binary.ts --target=bun-windows-x64",
    "build:binary:windows-arm64": "bun run scripts/build-binary.ts --target=bun-windows-arm64",
    "install:local": "bun run scripts/install-local.ts",
    "install:extension": "bun run --cwd vscode install:local",
    "release": "bun run scripts/release.ts",
    "events:search": "bun run src/cli/index.ts events search",
    "events:maintain": "bun run src/cli/index.ts events maintain",
    "workflow:verify": "bun run src/cli/index.ts workflow verify",
    "search:benchmark": "bun run bench/search-benchmark.ts",
    "models:snapshot": "bun run scripts/refresh-models-snapshot.ts",
    "licenses:generate": "bun run scripts/generate-third-party-licenses.ts",
    "licenses:check": "bun run scripts/generate-third-party-licenses.ts --check",
    "docs:generate": "bun --conditions=browser --preload=@opentui/solid/preload run scripts/generate-docs.ts",
    "lint": "bun run scripts/lint-parallel.ts",
    "lint:tsc": "bunx --bun tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "lint:model-catalog": "bun run scripts/check-model-catalog.ts",
    "lint:provider-model-literals": "bun run scripts/check-provider-model-literals.ts",
    "lint:test-types": "bunx --bun tsc -p tsconfig.tests.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo-tests",
    "lint:skills": "bun run scripts/check-bundled-skills.ts",
    "lint:oxlint": "NAPI_RS_NATIVE_LIBRARY_PATH= bunx --bun oxlint --deny-warnings --config oxlint.config.ts src/ scripts/ bench/chat-ab/*.ts bench/search-benchmark.ts tests/unit tests/integration tests/release && NAPI_RS_NATIVE_LIBRARY_PATH= bunx --bun oxlint --deny-warnings --config scripts/oxlint-partial.jsonc bench tests/helpers tests/fixtures tests/e2e tests/preload.ts",
    "lint:knip": "NAPI_RS_NATIVE_LIBRARY_PATH= bunx --bun knip",
    "lint:knip-production": "NAPI_RS_NATIVE_LIBRARY_PATH= bunx --bun knip --config knip.production.jsonc",
    "lint:files": "bun run scripts/check-file-sizes.ts",
    "lint:filenames": "bun run scripts/check-filenames.ts",
    "lint:terminal-io": "bun run scripts/check-terminal-io.ts",
    "lint:safety": "bun run scripts/check-safety-comments.ts",
    "lint:owned-processes": "bun run scripts/check-owned-process-launches.ts",
    "lint:worker-ownership": "bun run scripts/check-worker-ownership.ts",
    "lint:generated-docs": "bun --conditions=browser --preload=@opentui/solid/preload run scripts/generate-docs.ts --check",
    "lint:doc-coherence": "bun run scripts/check-doc-coherence.ts",
    "lint:doc-src-paths": "bun run scripts/check-doc-src-paths.ts",
    "lint:terminology": "bun run scripts/check-terminology.ts",
    "lint:intent": "bun run scripts/check-intent-corpora.ts",
    "lint:diagnostics": "bun run scripts/check-diagnostics-registry.ts",
    "lint:fact-retention": "bun run scripts/check-fact-retention.ts",
    "lint:module-containment": "bun run scripts/check-module-containment.ts",
    "lint:projections": "bun run scripts/check-projection-registry.ts",
    "lint:vscode": "bun run scripts/lint-vscode.ts",
    "lint:webview": "bun run scripts/lint-webview.ts",
    "lint:relay": "bun run scripts/lint-relay.ts",
    "lint:licenses": "bun run licenses:check",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:commits": "bun run scripts/commit-contract.ts check",
    "check:claude-engine": "bun run scripts/claude-engine-release.ts",
    "test:ci": "bun run lint && bun run test && bun run check:boundaries && bun run check:commits --upstream --head HEAD",
    "test:perf": "bun run scripts/perf-gate.ts",
    "test:perf:release": "bun run scripts/perf-gate.ts --set release",
    "readiness": "bun run scripts/readiness.ts",
    "readiness:login": "bun run scripts/readiness-login.ts",
    "notes:draft": "bun run scripts/release-notes.ts --surface terminal",
    "bench:coding": "bun --conditions=browser run bench/chat-ab/coding-ab.ts",
    "bench:planning": "bun --conditions=browser run bench/chat-ab/planning.ts",
    "bench:workflow-audit": "bun --conditions=browser run bench/chat-ab/workflow-audit.ts",
    "bench:workflow-authorship": "bun --conditions=browser run bench/chat-ab/workflow-authorship.ts",
    "lint:bench": "bunx --bun tsc --ignoreConfig --noEmit --target ESNext --module ESNext --moduleResolution bundler --strict --noUncheckedIndexedAccess --noImplicitOverride --noFallthroughCasesInSwitch --skipLibCheck --types bun bench/search-benchmark.ts bench/ab-persona/bench.ts bench/ab-persona/compare.ts bench/ab-persona/strategy-bench.ts bench/ab-persona/chat-routing-bench.ts bench/chat-ab/bench.ts bench/chat-ab/compare.ts bench/chat-ab/check-task.ts bench/chat-ab/score.ts bench/chat-ab/paired.ts bench/chat-ab/workflow-audit.ts bench/chat-ab/workflow-authorship.ts bench/chat-ab/coding-ab.ts bench/chat-ab/planning.ts bench/shared/runtime.ts bench/linux-runtime-verification/smoke.ts bench/terminal_bench/run-terminal-bench.ts bench/terminal_bench/terminal-bench-config.ts bench/terminal_bench/disclosure-ledger.ts bench/terminal_bench/analyze-tool-outcomes.ts src/orchestration/modules/development/benchmark/chat-routing-run.ts src/orchestration/modules/development/benchmark/matrix-runner.ts tests/unit/orchestration/modules/development/benchmark/matrix-runner.test.ts tests/unit/bench/*.test.ts",
    "postinstall": "bun run scripts/patch-deps.ts"
  },
  "//tree-sitter": "web-tree-sitter held at 0.25.10 because @opentui/core pins that exact peer; portable grammars come from @vscode/tree-sitter-wasm",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sdk": "0.98.0",
    "@google/genai": "2.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@solid-primitives/keyed": "^1.5.3",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "acorn": "8.19.0",
    "amaro": "1.3.0",
    "diff": "9.0.0",
    "effect": "4.1.2",
    "fuzzysort": "^3.1.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "3.3.1",
    "marked": "18.1.2",
    "msgpackr": "^2.1.3",
    "openai": "^6.39.0",
    "qrcode": "1.5.4",
    "sharp": "^0.35.3",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "web-tree-sitter": "0.25.10",
    "xstate": "6.0.0-alpha.71",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "eslint-plugin-solid": "^0.14.5",
    "knip": "6.14.2",
    "oxlint": "^1.70.0",
    "typescript": "7.0.2",
    "ultracite": "^7.8.3",
    "xcodebuildmcp": "2.7.0"
  },
  "description": "Flywheel is a Bun-powered terminal app for running agentic coding workflows from a native TUI.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "tui",
    "terminal",
    "workflows",
    "llm",
    "bun"
  ],
  "author": "Wesley Sauret",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsauret/flywheel.git"
  },
  "homepage": "https://flywl.sh",
  "bugs": {
    "url": "https://github.com/wsauret/flywheel/issues"
  }
}
