{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flywheel/schemas/state.schema.json",
  "title": "Execution state (state.json)",
  "description": "Runtime state written by work-implementation. Tracks phase status, strikes, BC satisfaction, and artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "status", "phases", "learnings", "error_log"],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}(-\\d+)?$" },
    "status": {
      "enum": ["pending", "in_progress", "paused", "completed"]
    },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "summary": { "type": "string" },
    "mode": { "enum": ["plan", "fix-findings"] },
    "phases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phase_state" }
    },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "error_log": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "phase_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "outcomes",
        "strikes",
        "bc_satisfied",
        "artifacts"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["pending", "in_progress", "paused", "completed"]
        },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "outcomes": { "type": "array", "items": { "type": "string" } },
        "strikes": { "type": "array", "items": { "type": "string" } },
        "bc_satisfied": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BC-[A-Z0-9]+-\\d{3}$" }
        },
        "artifacts": { "$ref": "#/$defs/artifacts" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_created", "files_modified", "commands_run"],
      "properties": {
        "files_created": { "type": "array", "items": { "type": "string" } },
        "files_modified": { "type": "array", "items": { "type": "string" } },
        "commands_run": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "stdout_tail"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "stdout_tail": { "type": "string" },
        "re_executable": { "type": "boolean", "default": true }
      }
    }
  }
}
