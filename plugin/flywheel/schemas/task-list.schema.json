{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flywheel/schemas/task-list.schema.json",
  "title": "Task list (spec.json)",
  "description": "Plan output consumed by work-implementation. Tasks live inside phases for grouping; no behavioral contracts, no fulfills claims, no origin metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "context", "phases", "success_criteria"],
  "properties": {
    "schema_version": { "const": 1 },
    "summary": { "type": "string", "minLength": 100, "maxLength": 5000 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_files", "patterns", "gotchas"],
      "properties": {
        "key_files": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "gotchas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } },
    "success_criteria": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "files", "tasks", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "verification": { "type": "string", "minLength": 1 },
        "manual_verification": { "type": ["string", "null"] }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "files", "test_scenarios"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string" } },
        "test_scenarios": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
