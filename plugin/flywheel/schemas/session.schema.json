{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flywheel/schemas/session.schema.json",
  "title": "Session metadata",
  "description": "Session-level metadata. Filenames on disk are constants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "slug", "status", "started_at", "active_skill"],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}(-\\d+)?$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "enum": ["active", "paused", "completed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "last_checkpoint_at": { "type": ["string", "null"], "format": "date-time" },
    "active_skill": {
      "oneOf": [
        { "enum": ["plan-creation", "plan-review", "plan-consolidation", "work-implementation", "work-review"] },
        { "type": "null" }
      ]
    }
  }
}
