{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flywheel/schemas/findings.schema.json",
  "title": "Reviewer findings",
  "description": "Synthesized review output. The orchestrating skill (plan-review or work-review) parses prose findings from each reviewer agent and structures them into this shape. Reviewers do NOT emit JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings", "open_questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "location", "failure", "fix"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["P1", "P2", "P3"] },
        "location": { "type": "string", "minLength": 1 },
        "failure": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 }
      }
    }
  }
}
