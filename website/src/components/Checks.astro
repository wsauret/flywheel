---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="checks">
  {items.map((item) => (
    <li><svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 7.5 5.5 11 12 3.5" /></svg>{item}</li>
  ))}
</ul>
