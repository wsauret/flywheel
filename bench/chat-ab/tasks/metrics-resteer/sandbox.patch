@@ -0,0 +1,21 @@
+import type { Rollup } from "./types.js";
+
+export interface ReaderOptions {
+  readRollups(): readonly Rollup[];
+  retentionMs: number;
+}
+
+export interface MetricsReader {
+  latest(metric: string, nowMs: number): Rollup | undefined;
+}
+
+export function createReader(options: ReaderOptions): MetricsReader {
+  return {
+    latest(metric, nowMs) {
+      const cutoffMs = nowMs - options.retentionMs;
+      return options.readRollups()
+        .filter((rollup) => rollup.metric === metric && rollup.windowEndMs >= cutoffMs)
+        .sort((left, right) => right.windowEndMs - left.windowEndMs)[0];
+    },
+  };
+}
diff --git a/report.ts b/report.ts
new file mode 100644
--- /dev/null
+++ b/report.ts
@@ -0,0 +1,30 @@
+import { createReader } from "./reader.js";
+import type { Rollup } from "./types.js";
+import { UNIT_NORMALIZERS } from "./units.js";
+
+export const RETENTION_MS = 60_000;
+
+export interface MetricReport {
+  metric: string;
+  count: number;
+  p95: number;
+}
+
+export interface ReportSource {
+  report(metric: string, nowMs: number): MetricReport | undefined;
+}
+
+export function createReportSource(readRollups: () => readonly Rollup[]): ReportSource {
+  const reader = createReader({ readRollups, retentionMs: RETENTION_MS });
+  return {
+    report(metric, nowMs) {
+      const rollup = reader.latest(metric, nowMs);
+      if (!rollup) return undefined;
+      return {
+        metric,
+        count: rollup.count,
+        p95: UNIT_NORMALIZERS[rollup.unit](rollup.p95),
+      };
+    },
+  };
+}
diff --git a/rollup.ts b/rollup.ts
new file mode 100644
--- /dev/null
+++ b/rollup.ts
@@ -0,0 +1,22 @@
+import { computePercentiles } from "./percentiles.js";
+import type { Rollup, Sample } from "./types.js";
+
+export function rollupSamples(samples: readonly Sample[], windowStartMs: number, windowEndMs: number): Rollup {
+  const first = samples[0];
+  if (!first) throw new Error("Cannot roll up an empty window");
+  if (samples.some((sample) => sample.metric !== first.metric || sample.unit !== first.unit)) {
+    throw new Error("A rollup window must contain one metric and unit");
+  }
+  const values = samples.map((sample) => sample.value);
+  const percentiles = computePercentiles(values);
+  return {
+    metric: first.metric,
+    windowStartMs,
+    windowEndMs,
+    count: values.length,
+    min: Math.min(...values),
+    max: Math.max(...values),
+    ...percentiles,
+    unit: first.unit,
+  };
+}
