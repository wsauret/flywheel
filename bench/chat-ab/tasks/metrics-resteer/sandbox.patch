+export type MetricUnit = "ms" | "s" | "count";
+
+export interface Sample {
+  metric: string;
+  timestampMs: number;
+  value: number;
+  unit: MetricUnit;
+}
+
+export interface Rollup {
+  metric: string;
+  windowStartMs: number;
+  windowEndMs: number;
+  count: number;
+  min: number;
+  max: number;
+  p50: number;
+  p95: number;
+  unit: MetricUnit;
+}
diff --git a/units.ts b/units.ts
new file mode 100644
--- /dev/null
+++ b/units.ts
@@ -0,0 +1,15 @@
+import type { MetricUnit } from "./types.js";
+
+export function normalizeUnit(value: number): number {
+  return value;
+}
+
+export function secondsToMilliseconds(value: number): number {
+  return value * 1_000;
+}
+
+export const UNIT_NORMALIZERS: Readonly<Record<MetricUnit, (value: number) => number>> = {
+  ms: normalizeUnit,
+  s: secondsToMilliseconds,
+  count: normalizeUnit,
+};
