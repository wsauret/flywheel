+++ b/src/processor.py
@@ -0,0 +1,17 @@
+"""Event processor — deduplicates and transforms events."""
+from .events import Event
+
+def process_events(events: list[Event], seen_ids: list[int] = []) -> list[Event]:
+    """Process events, skipping any previously seen IDs.
+
+    Tracks seen IDs to enable cross-batch deduplication when the caller
+    passes a shared seen_ids list. When called without seen_ids, each
+    call should process independently.
+    """
+    result = []
+    for e in events:
+        if e.id not in seen_ids:
+            result.append(e)
+            seen_ids.append(e.id)
+    result.sort(key=lambda e: -e.priority)
+    return result
