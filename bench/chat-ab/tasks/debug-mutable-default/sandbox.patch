@@ -0,0 +1,13 @@
+"""Report generator — summarizes processed events."""
+from .events import Event
+
+def generate_summary(events: list[Event]) -> dict:
+    """Generate a summary report from processed events."""
+    by_category: dict[str, int] = {}
+    for e in events:
+        by_category[e.category] = by_category.get(e.category, 0) + 1
+    return {
+        "total": len(events),
+        "by_category": by_category,
+        "highest_priority": events[0].message if events else None,
+    }
