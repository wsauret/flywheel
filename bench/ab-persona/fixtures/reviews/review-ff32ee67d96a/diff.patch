+  let rows = [row]
+  const first = Promise.withResolvers<RuntimeQuestionSnapshotResult>()
+  let current = first.promise
+  let questionReads = 0
+  const listeners = new Set<(event: FrontendEvent) => void>()
+  function query<Q extends RuntimeQuery>(request: Q): Promise<RuntimeQueryResult<Q>>
+  async function query(request: RuntimeQuery): Promise<RuntimeQueryResult<RuntimeQuery>> {
+    if (request.type === "snapshot") return { ...snapshot, rows, projectRoot: "/scratch/project" }
+    if (request.type === "questionSnapshot") { questionReads++; return current }
+    return base.query(request)
+  }
+  const session = createRuntimeSession({ connection: {
+    ...base, query,
+    subscribe(listener) { listeners.add(listener); return () => { listeners.delete(listener) } },
+  } })
+  const publish = (event: FrontendEvent) => { for (const listener of listeners) listener(event) }
+  const frames: boolean[] = []
+  session.onChange(() => { if (session.projectRoot !== undefined) frames.push(session.questionPresenceLoaded) })
+  try {
+    await settle()
+    assert.equal(session.projectRoot, "/scratch/project")
+    assert.equal(session.questionPresenceLoaded, false)
+    assert.ok(frames.length > 0)
+    assert.ok(frames.every((loaded) => !loaded))
+    first.resolve({ snapshotPosition: 0, views: [{ sessionId: row.id, view: { kind: "question", toolUseId: "q", questions: [], timestamp: 0 } }] })
+    await settle()
+    assert.equal(session.questionPresenceLoaded, true)
+    assert.deepEqual([...session.awaitingAnswer], [row.id])
+    publish({ type: "patch", patch: { cursor: { scope: "session", domain: "question", sessionId: row.id }, position: 1, prevPosition: 0, payload: { kind: "question.removed" } } })
+    assert.equal(session.questionPresenceLoaded, true)
+    assert.deepEqual([...session.awaitingAnswer], [])
+    publish({ type: "patch", patch: { cursor: { scope: "session", domain: "question", sessionId: row.id }, position: 2, prevPosition: 1, payload: { kind: "question.updated", question: { kind: "question", toolUseId: "new", questions: [], timestamp: 0 } } } })
+    assert.deepEqual([...session.awaitingAnswer], [row.id])
+    const next = Promise.withResolvers<RuntimeQuestionSnapshotResult>()
+    current = next.promise
+    frames.length = 0
+    publish({ type: "patch", patch: { cursor: { scope: "session", domain: "session", sessionId: "new" }, position: 1, prevPosition: 0, payload: { kind: "session.added", row: { ...row, id: "new" } } } })
+    await settle()
+    assert.equal(session.questionPresenceLoaded, false)
+    assert.ok(frames.length > 0)
+    assert.ok(frames.every((loaded) => !loaded))
+    next.resolve({ snapshotPosition: 1, views: [] })
+    await settle()
+    assert.equal(session.questionPresenceLoaded, true)
+    assert.deepEqual([...session.awaitingAnswer], [])
+  } finally { session.dispose() }
+  rows = []
+  const readsBeforeEmpty = questionReads
+  const sessionWithoutRows = createRuntimeSession({ connection: { ...base, query } })
+  try {
+    await settle()
+    assert.equal(sessionWithoutRows.questionPresenceLoaded, true)
+    assert.equal(questionReads, readsBeforeEmpty)
+  } finally { sessionWithoutRows.dispose() }
+})
