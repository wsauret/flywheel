 import type { ShipmentV1 } from "../protocol/v1.ts";
 
 export function toShipmentV1(shipment: Shipment): ShipmentV1 {
+  const window = shipment.estimatedDelivery;
   return {
     tracking_number: shipment.trackingNumber,
