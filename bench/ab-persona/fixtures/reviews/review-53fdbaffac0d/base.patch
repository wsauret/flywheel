+export function subscriptionSpendEvidenceStatus(evidence: SpendEvidence): string {
+  if (evidence.kind === "automatic-billing") return evidence.enablement === "enabled" ? "Enabled" : evidence.enablement === "disabled" ? "Disabled" : "Unknown"
+  if (evidence.availability === "funded") return "Funded"
+  if (evidence.availability === "available") return "Available with balance unavailable"
+  if (evidence.availability === "unlimited") return "Unlimited"
+  if (evidence.availability === "empty") return "Empty"
+  if (evidence.availability === "balance-unavailable") return "Balance unavailable"
+  return "Unknown"
+}
+
+export function subscriptionSpendExactEvidence(evidence: SpendEvidence): string[] {
+  if (evidence.kind === "prepaid" && evidence.availability !== "funded") return []
+  const values = [["Used", evidence.used], ["Limit", evidence.limit], ["Remaining", evidence.remaining]] as const
+  return values.flatMap(([label, value]) => value?.precision === "exact" ? [`${label}: ${formatEvidenceValue(value)}`] : [])
+}
+
+function formatEvidenceValue(value: NonNullable<SpendEvidence extends infer Evidence ? Evidence extends { used?: infer Value } ? Value : never : never>): string {
+  if (value.kind === "money") return `${value.value} ${value.currency}`
+  if (value.kind === "count") return `${value.value} ${value.unit}`
+  return `${value.value * 100}%`
+}
+
+export function subscriptionSpendConsentLabel(mode: CapabilityMode, checked: boolean): string {
+  if (checked) return mode.canEnable ? "On" : "On, currently unavailable"
+  return "Off"
+}
