+function exactEvidence(evidence: SubscriptionSpendSource): readonly string[] {
+  if (evidence.kind === "prepaid" && evidence.availability !== "funded") return []
+  const values = [["Used", evidence.used], ["Limit", evidence.limit], ["Remaining", evidence.remaining]] as const
+  return values.flatMap(([label, value]) => value?.precision === "exact" ? [`${label}: ${formatValue(value)}`] : [])
+}
+
+function formatValue(value: NonNullable<Extract<SubscriptionSpendSource, { readonly kind: "automatic-billing" }>["used"]>): string {
+  if (value.kind === "money") return `${value.value} ${value.currency}`
+  if (value.kind === "count") return `${value.value} ${value.unit}`
+  return `${value.value * 100}%`
+}
+
+function title(value: string): string {
+  return value.charAt(0).toUpperCase() + value.slice(1)
