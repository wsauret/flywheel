+function evidenceStatus(evidence: SubscriptionSpendSource): string {
+  if (evidence.kind === "automatic-billing") return title(evidence.enablement)
+  if (evidence.availability === "balance-unavailable") return "Balance unavailable"
+  if (evidence.availability === "available") return "Available with balance unavailable"
+  return title(evidence.availability)
