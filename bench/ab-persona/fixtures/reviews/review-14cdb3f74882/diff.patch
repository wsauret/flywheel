@@ -0,0 +1,14 @@
+import { describe, expect, it } from "bun:test"
+import { namesDirectory } from "../../helpers/real-process-fixture.js"
+
+describe("directory-tagged process discovery", () => {
+  it.each(["/workspace/gate", "C:\\workspace\\gate"])("matches directory boundaries under %s, not sibling prefixes", (root) => {
+    const separator = root.includes("\\") ? "\\" : "/"
+    expect(namesDirectory(`bun "${root}${separator}candidate${separator}flywheel" serve`, root)).toBe(true)
+    expect(namesDirectory(`bun "${root}3.ps1"`, root)).toBe(false)
+    expect(namesDirectory(`bun --home="${root}"`, root)).toBe(true)
+    expect(namesDirectory(`bun "${root}-other${separator}flywheel"`, root)).toBe(false)
+    expect(namesDirectory(`bun "${root}.ps1"`, root)).toBe(false)
+    expect(namesDirectory(`bun "${root}${separator}a file.ts"`, root)).toBe(true)
+  })
+})
