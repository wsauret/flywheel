+  it("names each provider whose quota-refused account holds a banked reset, without predicting that it helps", () => {
+    const hint = "ChatGPT has a banked reset. Open Usage (/usage) to apply it.";
+    const banked = exhaustedProvidersCopy([
+      { provider: "ChatGPT", cause: "quota", detail: "out of quota", resetsAtMs: undefined, bankedReset: true },
+      { provider: "ChatGPT", cause: "quota", detail: "out of quota", resetsAtMs: undefined, bankedReset: true },
+      { provider: "OpenAI", cause: "quota", detail: "insufficient_quota", resetsAtMs: undefined },
+    ]);
+    expect(banked.title).toBe("Out of credits");
+    expect(banked.message.endsWith(` ${hint}`)).toBe(true);
+    expect(banked.message.match(/banked reset/g)).toHaveLength(1);
+    expect(banked.message).not.toContain("OpenAI has");
+
+    const plain = exhaustedProvidersCopy([{ provider: "ChatGPT", cause: "quota", detail: "out of quota", resetsAtMs: undefined }]);
+    expect(plain.message).not.toContain("banked reset");
+    // A reset restores used-up included usage only, so another refusal names none.
+    const throttled = exhaustedProvidersCopy([{ provider: "ChatGPT", cause: "rate_limit", detail: "slow down", resetsAtMs: undefined, bankedReset: true }]);
+    expect(throttled.message).not.toContain("banked reset");
+  });
+});
