new file mode 100644
index 0000000..ca370aa
--- /dev/null
+++ b/payout.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, test } from "bun:test";
+import { createValidatorRegistry } from "./registry.ts";
+import { payoutSettledValidator } from "./validators.ts";
+
+describe("payout.settled validation", () => {
+  const registry = createValidatorRegistry([payoutSettledValidator]);
+
+  test("the registry resolves payout.settled to its validator", () => {
+    expect(registry.get("payout.settled")).toBe(payoutSettledValidator);
+  });
+
+  test("accepts a settled payout with all required fields", () => {
+    const validator = registry.get("payout.settled");
+    expect(validator?.validate({ payoutId: "po_1", amountCents: 5000, currency: "USD" })).toEqual([]);
+  });
+
+  test("flags a payout with a missing currency", () => {
+    const validator = registry.get("payout.settled");
+    expect(validator?.validate({ payoutId: "po_1", amountCents: 5000 })).toEqual(["currency must be a non-empty string"]);
+  });
+});
