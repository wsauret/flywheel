+import { describe, expect, test } from "bun:test";
+import {
+  createCopilotSpendObserver,
+  createProviderAvailability,
+  type ProviderAvailability,
+} from "../../../../../src/orchestration/agent-runtime/llm/provider-availability.js";
+
+function availabilityOwner(): ProviderAvailability {
+  return createProviderAvailability({ now: () => 0, fetch: () => { throw new Error("no poll expected") } });
+}
+
+/** Frames as each supported Copilot wire protocol carries the request total. */
+const responsesCompleted = {
+  type: "response.completed",
+  response: { id: "resp_1", status: "completed", copilot_usage: { total_nano_aiu: 4_473_525_000 } },
+};
+const chatCompletionsFinalChunk = {
+  id: "chatcmpl_1",
+  choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+  usage: { prompt_tokens: 10, completion_tokens: 2 },
+  copilot_usage: { total_nano_aiu: 4_473_525_000 },
+};
+const anthropicMessageDelta = {
+  type: "message_delta",
+  delta: { stop_reason: "end_turn" },
+  usage: { output_tokens: 2 },
+  message: { copilot_usage: { total_nano_aiu: 4_473_525_000 } },
+};
+
+describe("Copilot request-total observation", () => {
+  test.each([
+    ["OpenAI Responses", responsesCompleted],
+    ["OpenAI chat completions", chatCompletionsFinalChunk],
+    ["Anthropic messages", anthropicMessageDelta],
+  ])("records one request total from a %s stream", (_protocol, frame) => {
+    const availability = availabilityOwner();
+    const observer = createCopilotSpendObserver(availability);
+
+    observer.observe({ type: "irrelevant" });
+    observer.observe(frame);
+    observer.commit();
+
+    expect(availability.copilotSpendSinceRefreshNanoAiu()).toBe(4_473_525_000);
+  });
+
+  test("a total repeated across frames is counted once, at its final value", () => {
+    const availability = availabilityOwner();
+    const observer = createCopilotSpendObserver(availability);
+
+    observer.observe({ copilot_usage: { total_nano_aiu: 1_000 } });
+    observer.observe({ copilot_usage: { total_nano_aiu: 2_500 } });
+    observer.commit();
+
+    expect(availability.copilotSpendSinceRefreshNanoAiu()).toBe(2_500);
+  });
+
+  test("a stream that carries no Copilot total records nothing", () => {
+    const availability = availabilityOwner();
+    const observer = createCopilotSpendObserver(availability);
+
+    observer.observe({ type: "response.completed", response: { id: "resp_1" } });
+    observer.observe({ copilot_usage: { total_nano_aiu: "free" } });
+    observer.commit();
+
+    expect(availability.copilotSpendSinceRefreshNanoAiu()).toBe(0);
+  });
+
+  test("each attempt commits its own request total", () => {
+    const availability = availabilityOwner();
+
+    for (const total of [1_000, 2_000]) {
+      const observer = createCopilotSpendObserver(availability);
+      observer.observe({ copilot_usage: { total_nano_aiu: total } });
+      observer.commit();
+    }
+
+    expect(availability.copilotSpendSinceRefreshNanoAiu()).toBe(3_000);
+  });
+});
