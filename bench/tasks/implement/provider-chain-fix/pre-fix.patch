+/** Records the audit calls one assistant turn makes, keyed by the request
+ *  record each call belongs to. */
+function recordingAudit(): {
+  requestAudit: ProviderRequestAuditWriter;
+  requests: Array<{ requestId: string; accessProvider: AccessProviderId }>;
+  responses: Array<{ requestId: string; outcome: string; tag: string | undefined }>;
+  streamStarts: string[];
+  streamCompletions: Array<{ requestId: string; outcome: string }>;
+} {
+  let nextRequest = 0;
+  const requests: Array<{ requestId: string; accessProvider: AccessProviderId }> = [];
+  const responses: Array<{ requestId: string; outcome: string; tag: string | undefined }> = [];
+  const streamStarts: string[] = [];
+  const streamCompletions: Array<{ requestId: string; outcome: string }> = [];
+  const requestAudit: ProviderRequestAuditWriter = {
+    recordRequest(input) {
+      nextRequest += 1;
+      const requestId = `request-${nextRequest}`;
+      requests.push({ requestId, accessProvider: input.attribution.accessProvider });
+      return { requestId, turn: input.turn };
+    },
+    recordResponse(handle, input) {
+      responses.push({ requestId: handle.requestId, outcome: input.outcome, tag: input.error?.tag });
+    },
+    recordUsage() {},
+    recordStreamStarted(handle) { streamStarts.push(handle.requestId) },
+    recordStreamEvent() {},
+    recordStreamCompleted(handle, input) {
+      streamCompletions.push({ requestId: handle.requestId, outcome: input.outcome });
+    },
+  };
+  return { requestAudit, requests, responses, streamStarts, streamCompletions };
+}
+
+function runTurn(client: LLMClient, requestAudit: ProviderRequestAuditWriter): ReturnType<typeof streamAssistantTurn> {
+  return streamAssistantTurn({
+    client,
+    messages: [],
+    tools: [],
+    systemPrompt: "s",
+    reasoningEffort: undefined,
+    signal: undefined,
+    cacheRetention: "1h",
+    cacheKey: undefined,
+    providerOptions: undefined,
+    requestAudit,
+    staleMasking: undefined,
+    turn: 1,
+    messageCount: 0,
+    estimatedContextTokens: 0,
+    onEvent: () => {},
+  });
+}
+
+function doneStream(text: string): () => AsyncGenerator<ProviderStreamEvent> {
+  return async function* () {
+    yield { kind: "text_delta", text, blockKey: "b1" };
+    yield { kind: "done", stopReason: "end_turn" };
+  };
+}
+
+describe("per-attempt audit attribution", () => {
+  test("each provider request the chain sends gets its own record, and its telemetry and terminal facts join that record", async () => {
+    const audit = recordingAudit();
+    const client = await createProviderChainClient({
+      model: "gpt-5.5",
+      family: "openai",
+      candidates: ["chatgpt", "openai_api"],
+      build: async (provider) => fakeClient(
+        provider,
+        provider === "chatgpt"
+          ? throwingStream(new QuotaExhaustedError("usage limit reached"))
+          : doneStream("second"),
+      ),
+      availability: fakeAvailability({}).availability,
+      sessionId: "session-1",
+      onNotice: () => {},
+    });
+
+    const result = await runTurn(client, audit.requestAudit);
+
+    expect(result.outcome).toEqual({ kind: "ok", stopReason: "end_turn" });
+    expect(audit.requests).toEqual([
+      { requestId: "request-1", accessProvider: "chatgpt" },
+      { requestId: "request-2", accessProvider: "openai_api" },
+    ]);
+    expect(audit.responses).toEqual([
+      { requestId: "request-1", outcome: "stream_error", tag: "QuotaExhausted" },
+      { requestId: "request-2", outcome: "ok", tag: undefined },
+    ]);
+    expect(audit.streamStarts).toEqual(["request-1", "request-2"]);
+    expect(audit.streamCompletions).toEqual([
+      { requestId: "request-1", outcome: "stream_error" },
+      { requestId: "request-2", outcome: "ok" },
+    ]);
+  });
+});
+
+describe("completion failover", () => {
+  test("a completion restarts on the next candidate after a terminal quota failure", async () => {
+    const completions: AccessProviderId[] = [];
+    const client = await createProviderChainClient({
+      model: "gpt-5.5",
+      family: "openai",
+      candidates: ["chatgpt", "openai_api"],
+      build: async (provider) => ({
+        ...fakeClient(provider, textStream("unused")),
