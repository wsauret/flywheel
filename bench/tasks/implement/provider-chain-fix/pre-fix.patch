+type CopilotAvailabilityResult = Awaited<ReturnType<ProviderAvailability["copilotAvailability"]>>;
+type ChatGptQuotaResult = ReturnType<ProviderAvailability["chatGptQuota"]>;
+
+interface AvailabilityScript {
+  copilot?: CopilotAvailabilityResult;
+  chatGpt?: ChatGptQuotaResult;
+}
+
+function fakeAvailability(script: AvailabilityScript): { availability: ProviderAvailability; copilotPolls: number } {
+  const state = { copilotPolls: 0 };
+  const availability: ProviderAvailability = {
+    async copilotAvailability() {
+      state.copilotPolls += 1;
+      return script.copilot ?? { available: true, meter: undefined };
+    },
+    copilotSpendSinceRefreshNanoAiu: () => 0,
+    observeCopilotSpend: () => {},
+    observeChatGptRateHeaders: () => {},
+    observeChatGptQuotaExhausted: () => {},
+    chatGptQuota: () => script.chatGpt ?? { primary: undefined, secondary: undefined },
+  };
+  return { availability, get copilotPolls() { return state.copilotPolls } };
+}
+
+function fakeClient(accessProvider: AccessProviderId, stream: () => AsyncGenerator<ProviderStreamEvent>): LLMClient {
+  return {
+    accessProvider,
+    modelFamily: "openai",
+    model: "gpt-5.5",
+    contextLimit: 400_000,
+    outputLimit: 64_000,
+    supportsReasoning: true,
+    promptNotes: { progress: "", modelNotes: "" },
+    streamWithTools: stream,
+    complete: async () => "",
+    costFor: () => 0,
+  };
+}
+
+function textStream(text: string): () => AsyncGenerator<ProviderStreamEvent> {
+  return async function* () {
+    yield { kind: "text_delta", text, blockKey: "b1" };
+  };
+}
+
+function throwingStream(error: Error, before?: ProviderStreamEvent): () => AsyncGenerator<ProviderStreamEvent> {
+  return async function* () {
+    if (before) yield before;
+    throw error;
+  };
+}
+
+const streamOptions: StreamOptions = { messages: [], tools: [], systemPrompt: "s" };
+
+async function collect(stream: AsyncGenerator<ProviderStreamEvent>): Promise<ProviderStreamEvent[]> {
+  const events: ProviderStreamEvent[] = [];
+  for await (const event of stream) events.push(event);
+  return events;
+}
+
+function upserts(notices: SessionNoticeOperation[]): Array<Extract<SessionNoticeOperation, { type: "upsert" }>["notice"]> {
+  return notices.flatMap((operation) => (operation.type === "upsert" ? [operation.notice] : []));
+}
