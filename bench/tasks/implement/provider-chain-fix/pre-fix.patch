@@ -0,0 +1,355 @@
+import { describe, expect, test } from "bun:test";
+import { Redacted } from "effect";
+import { createProviderAvailability, NANO_AIU_PER_CREDIT } from "../../../../../src/orchestration/agent-runtime/llm/provider-availability.js";
+
+const auth = { githubToken: Redacted.make("github-token") };
+const query = { auth };
+const credits = (n: number): number => n * NANO_AIU_PER_CREDIT;
+
+function quotaBody(body: Record<string, unknown>): Response {
+  return new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } });
+}
+
+/** Enterprise seat: token-based billing states consumption, never a balance. */
+function enterpriseQuota(creditsUsed: number): Record<string, unknown> {
+  return {
+    quota_reset_date: "2026-08-01",
+    quota_snapshots: {
+      premium_interactions: { unlimited: true, token_based_billing: true, credits_used: creditsUsed },
+    },
+  };
+}
+
+/** Every other plan: a metered premium-interaction balance. */
+function seatQuota(remaining: number, entitlement = remaining): Record<string, unknown> {
+  return {
+    quota_reset_date: "2026-08-01",
+    quota_snapshots: {
+      premium_interactions: { unlimited: false, entitlement, remaining, overage_permitted: false },
+    },
+  };
+}
+
+/** Fake clock + fetch seam. `responses` is consumed one entry per poll. */
+function harness(responses: Array<() => Promise<Response>>) {
+  const calls: Array<{ url: string; headers: Headers }> = [];
+  let nowMs = 1_000_000;
+  const availability = createProviderAvailability({
+    now: () => nowMs,
+    fetch: (url, init) => {
+      calls.push({ url: String(url), headers: new Headers(init?.headers) });
+      const next = responses[calls.length - 1];
+      if (!next) throw new Error(`unexpected poll #${calls.length}`);
+      return next();
+    },
+  });
+  return { availability, calls, advance: (ms: number) => { nowMs += ms } };
+}
+
+const ok = (body: Record<string, unknown>) => async () => quotaBody(body);
+
+describe("Copilot quota polling", () => {
+  test("first resolution polls the quota endpoint with the static headers and the GitHub token", async () => {
+    const { availability, calls } = harness([ok(seatQuota(300))]);
+
+    await availability.copilotAvailability(query);
+
+    expect(calls).toHaveLength(1);
+    expect(calls[0]?.url).toBe("https://api.github.com/copilot_internal/user");
+    expect(calls[0]?.headers.get("authorization")).toBe("Bearer github-token");
