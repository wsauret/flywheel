diff --git a/src/infra/llm/claude-model-id.ts b/src/infra/llm/claude-model-id.ts
new file mode 100644
index 000000000..354c16327
--- /dev/null
+++ b/src/infra/llm/claude-model-id.ts
@@ -0,0 +1,18 @@
+// Claude model ids have two wire forms: Anthropic's dashed form
+// (claude-opus-4-8), which is Flywheel's internal canonical, and Copilot's
+// dotted form (claude-opus-4.8). Fold once at each boundary: listings fold to
+// dashed on the way in; the Copilot adapter folds to dotted on the way out
+// (its proxy rejects dashed ids with 400 model_not_supported).
+
+const DOTTED_VERSION_RE = /^(claude-(?:opus|sonnet|haiku)-\d+)\.(\d+)/;
+const DASHED_VERSION_RE = /^(claude-(?:opus|sonnet|haiku)-\d+)-(\d+)/;
+
+/** Internal canonical (dashed) form of a Claude id; other ids pass through. */
+export function claudeDashedModelId(model: string): string {
+  return model.replace(DOTTED_VERSION_RE, "$1-$2");
+}
+
+/** Copilot wire (dotted) form of a Claude id; other ids pass through. */
+export function claudeDottedModelId(model: string): string {
+  return model.replace(DASHED_VERSION_RE, "$1.$2");
+}
diff --git a/src/infra/llm/openrouter-model-support.ts b/src/infra/llm/openrouter-model-support.ts
new file mode 100644
index 000000000..6a3fcddc9
--- /dev/null
+++ b/src/infra/llm/openrouter-model-support.ts
@@ -0,0 +1,89 @@
+import { canonicalize } from "../canonical-name.js";
+import { claudeDashedModelId, claudeDottedModelId } from "./claude-model-id.js";
+
+/** OpenRouter wire ids are "vendor/slug" with an optional ":variant" suffix
+ *  (e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o:free). Frontier mirrors
+ *  fold to their first-party internal ids at the listing boundary and back to
+ *  wire form at the outbound request, so the vendor prefix never becomes a
+ *  model identity inside Flywheel. Only whitelisted non-mirror models keep
+ *  their slash id internally, because they have no first-party form. */
+const OPENROUTER_MODEL_ID_PATTERN = /^[\w.-]+\/[\w.:-]+$/;
+
+/** First-party prefixes OpenRouter mirrors, with the wire vendor segment.
+ *  Single source for both translation directions. New frontier releases
+ *  match by prefix and need no edit here. */
+const MIRROR_VENDOR_BY_PREFIX: ReadonlyArray<readonly [RegExp, string]> = [
+  [/^claude-/, "anthropic"],
+  [/^(gpt-|o\d|codex-|chatgpt-)/, "openai"],
+  [/^(gemini-|gemma-)/, "google"],
+];
+
+/** Manually curated non-mirror models. OpenRouter lists hundreds of models,
+ *  far too many for the picker or tier inference, so only these are
+ *  supported. Extend this set deliberately, one model at a time. */
+const OPENROUTER_MODEL_WHITELIST: ReadonlySet<string> = new Set([
+  "x-ai/grok-4.5",
+  "moonshotai/kimi-k3",
+  "meta/muse-spark-1.1",
+]);
+
+export function isOpenRouterModelId(model: string): boolean {
+  return OPENROUTER_MODEL_ID_PATTERN.test(canonicalize(model));
+}
+
+function baseModelId(model: string): string {
+  const variantStart = model.indexOf(":");
+  return variantStart === -1 ? model : model.slice(0, variantStart);
+}
+
+export function isWhitelistedOpenRouterModel(model: string): boolean {
+  return OPENROUTER_MODEL_WHITELIST.has(baseModelId(canonicalize(model)));
+}
+
+/** Internal model id -> OpenRouter wire id. Null when OpenRouter cannot
+ *  serve the model: a slash id outside the whitelist, or a first-party id
+ *  with no mirrored vendor prefix (e.g. bare grok-*). Claude ids fold to the
+ *  dotted wire form, the inverse of the listing fold below. */
+export function toOpenRouterWireId(model: string): string | null {
+  const canonical = canonicalize(model);
+  if (isOpenRouterModelId(canonical)) {
+    return isWhitelistedOpenRouterModel(canonical) ? canonical : null;
+  }
+  const entry = MIRROR_VENDOR_BY_PREFIX.find(([prefix]) => prefix.test(canonical));
+  return entry ? `${entry[1]}/${claudeDottedModelId(canonical)}` : null;
+}
+
+/** OpenRouter wire id -> internal model id. Whitelisted models keep their
+ *  slash id; mirrors fold to the first-party id (anthropic/claude-opus-4.8
+ *  -> claude-opus-4-8). Null for uncurated models and for ":variant" wire
+ *  ids: a variant is an OpenRouter routing option, not a distinct model, so
+ *  a listing never advertises one (an explicit variant pin still serves
+ *  through toOpenRouterWireId). */
+export function fromOpenRouterWireId(wireId: string): string | null {
+  const canonical = canonicalize(wireId);
+  if (canonical !== baseModelId(canonical)) return null;
+  if (isWhitelistedOpenRouterModel(canonical)) return canonical;
+  const slash = canonical.indexOf("/");
+  if (slash === -1) return null;
+  const vendor = canonical.slice(0, slash);
+  const internal = claudeDashedModelId(canonical.slice(slash + 1));
+  const mirrored = MIRROR_VENDOR_BY_PREFIX.some(([prefix, wireVendor]) => wireVendor === vendor && prefix.test(internal));
+  return mirrored ? internal : null;
+}
+
+/** Wire id for a model the availability gates already admitted. A missing
+ *  wire form past those gates is a producer bug, so this throws instead of
+ *  degrading the request. */
+export function requireOpenRouterWireId(model: string): string {
+  const wire = toOpenRouterWireId(model);
+  if (wire === null) throw new Error(openRouterModelUnavailableReason(model));
+  return wire;
+}
+
+export function openRouterModelUnavailableReason(model: string): string | undefined {
+  if (toOpenRouterWireId(model) !== null) return undefined;
+  if (isOpenRouterModelId(model)) {
+    return `"${model}" is not in Flywheel's curated OpenRouter set (the whitelist in openrouter-model-support.ts).`;
+  }
+  return `OpenRouter cannot serve "${model}": it has no OpenRouter wire form (mirrored claude-/gpt-/gemini- ids or a whitelisted vendor/model id).`;
+}
