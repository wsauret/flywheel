new file mode 100644
index 000000000..44b8745cd
--- /dev/null
+++ b/src/orchestration/agent-runtime/llm/provider-availability.ts
@@ -0,0 +1,336 @@
+/**
+ * Process-local owner of provider availability signals.
+ *
+ * Two providers meter Flywheel's calls with account-level state that no single
+ * request can see on its own: GitHub Copilot states its premium-interaction
+ * meter only on a separate quota endpoint, and the ChatGPT backend reports its
+ * usage windows in response headers. Parked chats, workflow steps, and subagent
+ * fan-out all spend from the same account, so that state belongs to one owner
+ * per process rather than to whichever adapter happened to see the last frame.
+ *
+ * The owner is memory-only. Quota is the provider's fact, not ours: nothing here
+ * is persisted, projected, or replayed, and a fresh process starts by polling.
+ *
+ * Scope matches `provider-rate-coordinator.ts`: one runtime worker owns all
+ * provider I/O for a workspace, and separate runtimes stay independent because
+ * they share no process state.
+ */
+
+import { Redacted } from "effect";
+import { COPILOT_STATIC_HEADERS } from "../../../infra/auth/copilot-auth-types.js";
+import { errorMessage } from "../../../infra/error-message.js";
+import { Log } from "../../../infra/log.js";
+import { isRecord } from "../../../infra/record.js";
+
+const log = Log.create({ service: "provider-availability" });
+
+/** Copilot bills in nano-AIU; credits are the unit the account is stated in. */
+export const NANO_AIU_PER_CREDIT = 1_000_000_000;
+
+/** Lower bound on the spacing between quota polls. Availability is resolved at
+ *  request boundaries and there is no timer, so a poll happens only when a
+ *  request asks and both the spend threshold and this gate are passed. */
+const MIN_POLL_INTERVAL_MS = 60_000;
+
+/** The poll threshold scales with the headroom the account still reports but
+ *  stays inside a fixed credit band, so a large account is not polled on every
+ *  request and a small one is still re-read before it drifts far. */
+const POLL_THRESHOLD_FRACTION = 0.10;
+const MIN_POLL_THRESHOLD_CREDITS = 5;
+const MAX_POLL_THRESHOLD_CREDITS = 100;
+
+const QUOTA_POLL_TIMEOUT_MS = 10_000;
+
+type FetchLike = (url: RequestInfo | URL, init?: RequestInit) => Promise<Response>;
+
+/** The GitHub token (not the exchanged Copilot token) authenticates the quota
+ *  endpoint, so the credential is passed in rather than read from the store. */
+interface CopilotQuotaAuth {
+  readonly githubToken: Redacted.Redacted<string>;
+  readonly enterpriseDomain?: string;
+}
+
+/** What the account's premium-interaction meter reported at the last poll.
+ *  Enterprise seats with token-based billing report consumption against no
+ *  server-side ceiling; every other plan reports a remaining balance. */
+type CopilotMeter =
+  | {
+    readonly kind: "token-billing";
+    readonly creditsUsed: number;
+    readonly resetsOn: string | undefined;
+  }
+  | {
+    readonly kind: "premium-interactions";
+    readonly remaining: number;
+    readonly entitlement: number | undefined;
+    readonly resetsOn: string | undefined;
+  };
+
+interface CopilotAvailability {
+  /** False only when a poll proved the account is out: an enterprise seat at or
+   *  above the configured monthly cap, or a plan with no premium interactions
+   *  left. An unknown meter permits the call: quota is the provider's to
+   *  enforce. */
+  readonly available: boolean;
+  /** The last polled meter, for cap and reset notices. Undefined until a poll
+   *  returns a usable snapshot. */
+  readonly meter: CopilotMeter | undefined;
+}
+
+export interface CopilotAvailabilityQuery {
+  readonly auth: CopilotQuotaAuth;
+  /** Operator-configured monthly credit cap. Enterprise token-based billing
+   *  states consumption without a ceiling, so the cap is ours to apply; an
+   *  absent cap means the seat is never reported as out of credits. */
+  readonly monthlyCapCredits?: number;
+}
+
+interface ChatGptRateWindow {
+  readonly usedPercent: number;
+  readonly windowMinutes: number | undefined;
+  /** Unix seconds at which the window resets, when the backend states one. */
+  readonly resetsAtSeconds: number | undefined;
+}
+
+interface ChatGptQuota {
+  readonly primary: ChatGptRateWindow | undefined;
+  readonly secondary: ChatGptRateWindow | undefined;
+}
+
+export interface ProviderAvailability {
+  /** Resolves Copilot availability. Polls the quota endpoint on the first
+   *  resolution, and after that only when the spend observed since the last
+   *  poll passes the poll threshold and the minimum poll interval has elapsed.
+   *  Concurrent callers share the one in-flight poll. */
+  copilotAvailability(query: CopilotAvailabilityQuery): Promise<CopilotAvailability>;
+  /** Copilot spend observed since the last successful poll, in nano-AIU. */
+  copilotSpendSinceRefreshNanoAiu(): number;
+  /** Adds one request's billed total to the spend since the last poll. */
+  observeCopilotSpend(totalNanoAiu: number): void;
+  /** Folds the rate-limit headers of any ChatGPT response, ok or error,
+   *  into the ChatGPT windows. */
+  observeChatGptRateHeaders(headers: Headers): void;
+  /** Folds a terminal ChatGPT quota frame into the same windows. */
+  observeChatGptQuotaExhausted(resetsAtSeconds: number | undefined): void;
+  chatGptQuota(): ChatGptQuota;
+}
+
+export interface ProviderAvailabilityDeps {
+  readonly fetch?: FetchLike;
+  readonly now?: () => number;
+}
+
+function finiteNonNegative(record: Record<string, unknown>, key: string): number | undefined {
+  const value = record[key];
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0) return undefined;
+  return value;
+}
+
+/** Credits the account can still spend, when the reported meter states one. An
+ *  enterprise seat states none without a configured cap. */
+function headroomCredits(meter: CopilotMeter | undefined, monthlyCapCredits: number | undefined): number | undefined {
+  if (meter === undefined) return undefined;
+  if (meter.kind === "premium-interactions") return meter.remaining;
+  return monthlyCapCredits === undefined ? undefined : Math.max(0, monthlyCapCredits - meter.creditsUsed);
+}
+
+/** Spend that must accumulate before the next poll is worth making. Unknown
+ *  headroom polls at the low end of the band, which is the conservative choice:
+ *  it re-reads the meter sooner, and it never withholds a request. */
+function pollThresholdNanoAiu(meter: CopilotMeter | undefined, monthlyCapCredits: number | undefined): number {
+  const headroom = headroomCredits(meter, monthlyCapCredits);
+  const credits = headroom === undefined
+    ? MIN_POLL_THRESHOLD_CREDITS
+    : Math.min(MAX_POLL_THRESHOLD_CREDITS, Math.max(MIN_POLL_THRESHOLD_CREDITS, headroom * POLL_THRESHOLD_FRACTION));
+  return credits * NANO_AIU_PER_CREDIT;
+}
+
+/** External boundary: normalizes the premium-interaction snapshot of the
+ *  `/copilot_internal/user` payload, and returns undefined when the payload
+ *  states no meter this owner can read. */
+function parseCopilotQuota(raw: unknown): CopilotMeter | undefined {
+  if (!isRecord(raw) || !isRecord(raw.quota_snapshots)) return undefined;
+  const premium = raw.quota_snapshots.premium_interactions;
+  if (!isRecord(premium)) return undefined;
+  const resetsOn = typeof raw.quota_reset_date === "string" ? raw.quota_reset_date : undefined;
+
+  if (premium.unlimited === true) {
+    // An unlimited seat without token-based billing reports no meter at all;
+    // there is nothing to read and nothing to enforce.
+    if (premium.token_based_billing !== true) return undefined;
+    const creditsUsed = finiteNonNegative(premium, "credits_used");
+    return creditsUsed === undefined ? undefined : { kind: "token-billing", creditsUsed, resetsOn };
+  }
+
+  const remaining = finiteNonNegative(premium, "remaining");
+  if (remaining === undefined) return undefined;
+  return { kind: "premium-interactions", remaining, entitlement: finiteNonNegative(premium, "entitlement"), resetsOn };
+}
+
+function headerNumber(headers: Headers, name: string): number | undefined {
+  const raw = headers.get(name);
+  if (raw === null) return undefined;
+  const value = Number(raw);
+  return Number.isFinite(value) ? value : undefined;
+}
+
+/** A window with no used-percent header was not reported, so the last observed
+ *  window stands. A window the backend reports as zero minutes long is inactive
+ *  and replaces the last observed one with nothing. */
+function readChatGptWindow(headers: Headers, prefix: string, current: ChatGptRateWindow | undefined): ChatGptRateWindow | undefined {
+  const usedPercent = headerNumber(headers, `${prefix}-used-percent`);
+  if (usedPercent === undefined) return current;
+  const windowMinutes = headerNumber(headers, `${prefix}-window-minutes`);
+  if (windowMinutes === 0) return undefined;
+  return { usedPercent, windowMinutes, resetsAtSeconds: headerNumber(headers, `${prefix}-reset-at`) };
+}
+
+export function createProviderAvailability(deps: ProviderAvailabilityDeps = {}): ProviderAvailability {
+  const fetchImpl = deps.fetch ?? fetch;
+  const now = deps.now ?? Date.now;
+
+  let meter: CopilotMeter | undefined;
+  let spentSinceRefreshNanoAiu = 0;
+  let lastPollStartedAtMs: number | undefined;
+  let poll: Promise<void> | null = null;
+  let chatGpt: ChatGptQuota = { primary: undefined, secondary: undefined };
+
+  async function readQuota(auth: CopilotQuotaAuth): Promise<CopilotMeter | undefined> {
+    const domain = auth.enterpriseDomain ?? "github.com";
+    // Provider-call adapter: the token is unwrapped only into the header.
+    const response = await fetchImpl(`https://api.${domain}/copilot_internal/user`, {
+      headers: {
+        Accept: "application/json",
+        Authorization: `Bearer ${Redacted.value(auth.githubToken)}`,
+        ...COPILOT_STATIC_HEADERS,
+      },
+      signal: AbortSignal.timeout(QUOTA_POLL_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`Copilot quota poll failed: ${response.status} ${response.statusText}`);
+    return parseCopilotQuota(await response.json());
+  }
+
+  function pollQuota(auth: CopilotQuotaAuth): Promise<void> {
+    poll ??= (async () => {
+      lastPollStartedAtMs = now();
+      // Spend observed while the poll is in flight is not yet in the new
+      // meter, so only the spend the poll already accounts for is cleared.
+      const accountedSpendNanoAiu = spentSinceRefreshNanoAiu;
+      try {
+        const next = await readQuota(auth);
+        if (!next) {
+          log.warn("Copilot quota poll returned an unusable meter; keeping the last snapshot");
+          return;
+        }
+        meter = next;
+        spentSinceRefreshNanoAiu -= accountedSpendNanoAiu;
+      } catch (err) {
+        log.warn("Copilot quota poll failed; keeping the last snapshot", { error: errorMessage(err) });
+      } finally {
+        poll = null;
+      }
+    })();
+    return poll;
+  }
+
+  /** Whether this resolution must read the endpoint. A poll already in flight
+   *  is joined rather than read past: the meter it is about to replace is the
+   *  one this caller would otherwise report. Accumulated spend only schedules
+   *  polls; it never meters availability. */
+  function shouldPoll(monthlyCapCredits: number | undefined): boolean {
+    if (poll !== null || lastPollStartedAtMs === undefined) return true;
+    return spentSinceRefreshNanoAiu >= pollThresholdNanoAiu(meter, monthlyCapCredits)
+      && now() - lastPollStartedAtMs >= MIN_POLL_INTERVAL_MS;
+  }
+
+  return {
+    async copilotAvailability({ auth, monthlyCapCredits }) {
+      if (shouldPoll(monthlyCapCredits)) await pollQuota(auth);
+      if (meter === undefined) return { available: true, meter: undefined };
+      const available = meter.kind === "token-billing"
+        ? monthlyCapCredits === undefined || meter.creditsUsed < monthlyCapCredits
+        : meter.remaining > 0;
+      return { available, meter };
+    },
+
+    copilotSpendSinceRefreshNanoAiu() {
+      return spentSinceRefreshNanoAiu;
+    },
+
+    observeCopilotSpend(totalNanoAiu) {
+      spentSinceRefreshNanoAiu += totalNanoAiu;
+    },
+
+    observeChatGptRateHeaders(headers) {
+      chatGpt = {
+        primary: readChatGptWindow(headers, "x-codex-primary", chatGpt.primary),
+        secondary: readChatGptWindow(headers, "x-codex-secondary", chatGpt.secondary),
+      };
+    },
+
+    observeChatGptQuotaExhausted(resetsAtSeconds) {
+      // The terminal frame does not name the window it hit; the primary window
+      // is the account-level limit the request was charged against.
+      chatGpt = {
+        ...chatGpt,
+        primary: {
+          usedPercent: 100,
+          windowMinutes: chatGpt.primary?.windowMinutes,
+          resetsAtSeconds: resetsAtSeconds ?? chatGpt.primary?.resetsAtSeconds,
+        },
+      };
+    },
+
+    chatGptQuota() {
+      return chatGpt;
+    },
+  };
+}
+
+let shared: ProviderAvailability | undefined;
+/** Process-lifetime singleton - the same module-cache idiom
+ *  `provider-rate-coordinator.ts` uses for account-level state that a
+ *  fresh-per-turn client must not own. */
+export function getSharedProviderAvailability(): ProviderAvailability {
+  shared ??= createProviderAvailability();
+  return shared;
+}
+
+/** Reads Copilot's billed request total (nano-AIU) out of a raw provider frame.
+ *  Copilot attaches it to the terminal frame of each wire protocol: on the
+ *  response for OpenAI Responses, on the final chunk for chat completions, and
+ *  on the message for Anthropic messages. */
+function copilotRequestTotalNanoAiu(frame: unknown): number | undefined {
+  if (!isRecord(frame)) return undefined;
+  for (const container of [frame, frame.response, frame.message]) {
+    if (!isRecord(container) || !isRecord(container.copilot_usage)) continue;
+    const total = finiteNonNegative(container.copilot_usage, "total_nano_aiu");
+    if (total !== undefined) return total;
+  }
+  return undefined;
+}
+
+export interface CopilotSpendObserver {
+  /** Reads any request total carried by a streamed frame. */
+  observe(frame: unknown): void;
+  /** Reports the request's final total. One observer serves one request, so a
+   *  total repeated across frames is recorded once. */
+  commit(): void;
+}
+
+/** Accumulates one request's Copilot spend. Requests that carry no Copilot
+ *  total (every non-Copilot provider) record nothing. */
+export function createCopilotSpendObserver(
+  availability: ProviderAvailability = getSharedProviderAvailability(),
+): CopilotSpendObserver {
+  let totalNanoAiu: number | undefined;
+  return {
+    observe(frame) {
+      totalNanoAiu = copilotRequestTotalNanoAiu(frame) ?? totalNanoAiu;
+    },
+    commit() {
+      if (totalNanoAiu === undefined) return;
+      availability.observeCopilotSpend(totalNanoAiu);
+    },
+  };
+}
diff --git a/src/orchestration/agent-runtime/llm/provider-chain-client.ts b/src/orchestration/agent-runtime/llm/provider-chain-client.ts
new file mode 100644
index 000000000..4bc5e5e2f
--- /dev/null
+++ b/src/orchestration/agent-runtime/llm/provider-chain-client.ts
@@ -0,0 +1,308 @@
+/**
+ * Automatic access-provider chain for a model client.
+ *
+ * Automatic selection (no pinned provider) walks the family chain in
+ * `access-provider.ts` order: subscription quota first, metered API keys after.
+ * This module turns that static order into the provider that actually serves
+ * the request. A candidate is dropped when the account cannot pay for it, and a
+ * request that dies on a terminal quota failure before producing any output
+ * restarts on the next candidate.
+ *
+ * One client serves many requests, and availability is account state, so the
+ * chain resolves its delegate once and keeps it: the provider that answered
+ * the last request answers the next one too, and a candidate the account can
+ * no longer pay for is left behind for the life of the client.
+ *
+ * Only terminal quota failures advance the chain. Every other failure stays
+ * with the retry and recovery policy that owns it: the chain must not turn one
+ * provider's transient blip into a silent provider switch.
+ *
+ * A pinned provider never reaches this module; `client-factory.ts` builds it
+ * directly, so an explicit pin cannot fail over.
+ */
+
+import type { AccessProviderId } from "../../../infra/llm/access-provider.js";
+import { accessProviderDisplayName, accessProviderShortName } from "../../../infra/llm/access-provider.js";
+import type { ModelFamily } from "../../../infra/llm/model-family.js";
+import { Log } from "../../../infra/log.js";
+import type { SessionNoticeOperation } from "../../../infra/session-notice.js";
+import { ApiError } from "../errors.js";
+import { QuotaExhaustedError } from "../shared/llm/errors.js";
+import { isCopilotModelSupported } from "./copilot-model-support.js";
+import {
+  getSharedProviderAvailability,
+  type CopilotAvailabilityQuery,
+  type ProviderAvailability,
+} from "./provider-availability.js";
+import {
+  type ConversationMessage,
+  type LLMClient,
+  providerRequestAttribution,
+  type ProviderStreamEvent,
+  type StreamOptions,
+} from "./types.js";
+
+const log = Log.create({ service: "provider-chain-client" });
+
+export interface ProviderChainDeps {
+  /** Normalized model name, as the adapters receive it. */
+  readonly model: string;
+  readonly family: ModelFamily;
+  /** Configured providers for this family and model, in automatic-selection
+   *  order. Availability is resolved here; membership is not. */
+  readonly candidates: readonly AccessProviderId[];
+  readonly build: (provider: AccessProviderId) => Promise<LLMClient>;
+  /** Process-local availability owner. Defaults to the shared one; tests and
+   *  isolated runtimes inject their own. */
+  readonly availability?: ProviderAvailability;
+  /** Copilot quota credential plus the operator's monthly cap. Present only
+   *  when the account is configured; the credential store is the factory's to
+   *  read, so the chain only asks. */
+  readonly copilotQuota?: CopilotAvailabilityQuery;
+  /** Canonical session the notices belong to. Availability is process-local
+   *  and shared across sessions, so the session scopes the notice. */
+  readonly sessionId?: string;
+  readonly onNotice?: (operation: SessionNoticeOperation) => void;
+}
+
+/** What the availability owner states about one provider's ability to pay for
+ *  the next request. `window` names the exhaustion window so one notice stands
+ *  for the whole window instead of one per request; `detail` states the cap or
+ *  reset in user-facing words and never carries a credential. */
+interface QuotaState {
+  readonly available: boolean;
+  readonly window: string;
+  readonly detail: string;
+}
+
+const UNMETERED: QuotaState = { available: true, window: "none", detail: "" };
+
+interface SkippedCandidate {
+  readonly provider: AccessProviderId;
+  readonly state: QuotaState;
+}
+
+interface Selection {
+  /** Position in `deps.candidates`. A failover walk resumes after it. */
+  readonly index: number;
+  readonly provider: AccessProviderId;
+  readonly client: LLMClient;
+}
+
+export async function createProviderChainClient(deps: ProviderChainDeps): Promise<LLMClient> {
+  const availability = deps.availability ?? getSharedProviderAvailability();
+  // Adapters are stateless with respect to selection, so one build per provider
+  // serves every request the chain routes to it.
+  const clients = new Map<AccessProviderId, Promise<LLMClient>>();
+
+  function clientFor(provider: AccessProviderId): Promise<LLMClient> {
+    const built = clients.get(provider) ?? deps.build(provider);
+    clients.set(provider, built);
+    return built;
+  }
+
+  async function quotaState(provider: AccessProviderId): Promise<QuotaState> {
+    if (provider === "github_copilot") return copilotQuotaState(availability, deps.copilotQuota);
+    if (provider === "chatgpt") return chatGptQuotaState(availability);
+    return UNMETERED;
+  }
+
+  /** First candidate at or after `from` that can serve the request, or the
+   *  candidates the walk skipped when the chain is spent. Skips are notified
+   *  only once their fallback is known, so one notice states both what was
+   *  skipped and what runs instead. */
+  async function selectFrom(from: number): Promise<Selection | { skipped: readonly SkippedCandidate[] }> {
+    const skipped: SkippedCandidate[] = [];
+    for (const [index, provider] of deps.candidates.entries()) {
+      if (index < from) continue;
+      // The Copilot model list is checked before the quota poll: a model
+      // Copilot does not serve is not worth an account round-trip.
+      if (provider === "github_copilot" && !isCopilotModelSupported(deps.model, deps.family)) {
+        log.info("skipping Copilot for an unsupported model", { model: deps.model });
+        continue;
+      }
+      const state = await quotaState(provider);
+      if (!state.available) {
+        skipped.push({ provider, state });
+        continue;
+      }
+      const client = await clientFor(provider);
+      for (const candidate of skipped) notifyQuota(deps, candidate.provider, candidate.state, provider);
+      resolveQuotaNotice(deps, provider);
+      return { index, provider, client };
+    }
+    return { skipped };
+  }
+
+  /** Serving provider, or the typed rejection when no candidate at or after
+   *  `from` can pay for the request. */
+  async function selectOrReject(from: number): Promise<Selection> {
+    const selection = await selectFrom(from);
+    if ("skipped" in selection) throw exhaustedChainError(deps.model, selection.skipped);
+    return selection;
+  }
+
+  // The identity this client reports, and therefore the provider a caller
+  // attributes a request to before the request starts. The chain's delegate is
+  // resolved here and moves only when a request dies on a terminal quota
+  // failure; a request that another candidate serves announces itself through
+  // `onProviderFailover` before its wire request.
+  const head = await selectOrReject(0);
+  let active = head;
+
+  /** Provider walk for one request. `announce` states the provider that serves
+   *  the next wire request whenever it is not the one the caller attributed the
+   *  request to, so the caller's audit record always names the provider that
+   *  actually sends it. */
+  function requestWalk(announce: StreamOptions["onProviderFailover"]) {
+    let attributed = head.provider;
+
+    async function report(selection: Selection): Promise<Selection> {
+      if (selection.provider === attributed) return selection;
+      attributed = selection.provider;
+      await announce?.(providerRequestAttribution(selection.client));
+      return selection;
+    }
+
+    return {
+      /** Provider that serves the first attempt: the chain's active delegate,
+       *  resolved when the client was built. */
+      async start(): Promise<Selection> {
+        return report(active);
+      },
+      /** Candidate that restarts the request after `failed` died on `error`.
+       *  The failed provider stays behind the walk: the availability owner does
+       *  not learn every provider's exhaustion from the failure frame, so a
+       *  walk from the top could hand the request straight back to it. Rethrows
+       *  `error` when no later candidate can pay. */
+      async advance(failed: Selection, error: QuotaExhaustedError): Promise<Selection> {
+        const selection = await selectFrom(failed.index + 1);
+        if ("skipped" in selection) throw error;
+        active = selection;
+        notifyQuota(deps, failed.provider, await quotaState(failed.provider), selection.provider, error.message);
+        log.warn("provider quota exhausted; restarting the request on the next candidate", {
+          from: failed.provider,
+          to: selection.provider,
+        });
+        return report(selection);
+      },
+    };
+  }
+
+  async function* streamWithTools(options: StreamOptions): AsyncGenerator<ProviderStreamEvent> {
+    const walk = requestWalk(options.onProviderFailover);
+    let serving = await walk.start();
+    for (;;) {
+      try {
+        yield* serving.client.streamWithTools(options);
+        return;
+      } catch (error) {
+        if (!(error instanceof QuotaExhaustedError)) throw error;
+        // Evidence gate: once the attempt produced durable turn content the
+        // turn is settled with that partial. Re-running it on another provider
+        // would duplicate the content and re-bill the prompt.
+        if (options.attemptProducedEvidence?.() === true) throw error;
+        serving = await walk.advance(serving, error);
+      }
+    }
+  }
+
+  // A completion leaves no durable turn content behind, so there is no evidence
+  // to protect: every terminal quota failure can restart on the next candidate.
+  // Completions carry no audit record, so the walk has nothing to announce to.
+  async function complete(messages: ConversationMessage[], systemPrompt?: string): Promise<string> {
+    const walk = requestWalk(undefined);
+    let serving = await walk.start();
+    for (;;) {
+      try {
+        return await serving.client.complete(messages, systemPrompt);
+      } catch (error) {
+        if (!(error instanceof QuotaExhaustedError)) throw error;
+        serving = await walk.advance(serving, error);
+      }
+    }
+  }
+
+  return {
+    get accessProvider() { return head.client.accessProvider },
+    get modelFamily() { return head.client.modelFamily },
+    get model() { return head.client.model },
+    get contextLimit() { return head.client.contextLimit },
+    get outputLimit() { return head.client.outputLimit },
+    get supportsReasoning() { return head.client.supportsReasoning },
+    get promptNotes() { return head.client.promptNotes },
+    get availableModels() { return head.client.availableModels },
+    streamWithTools,
+    complete,
+    costFor: (tokens) => head.client.costFor(tokens),
+  };
+}
+
+async function copilotQuotaState(
+  availability: ProviderAvailability,
+  query: CopilotAvailabilityQuery | undefined,
+): Promise<QuotaState> {
+  if (!query) return UNMETERED;
+  const { available, meter } = await availability.copilotAvailability(query);
+  const window = meter?.resetsOn ?? "cap";
+  if (available) return { available: true, window, detail: "" };
+  const reset = meter?.resetsOn ? ` The allowance resets on ${meter.resetsOn}.` : "";
+  const detail = meter?.kind === "token-billing"
+    ? `Copilot credits used (${meter.creditsUsed}) reached the configured monthly cap of ${query.monthlyCapCredits}.${reset}`
+    : `Copilot has no premium interactions left.${reset}`;
+  return { available: false, window, detail };
+}
+
+/** The primary ChatGPT window is the account-level limit a request is charged
+ *  against, so an exhausted primary window holds the whole provider. The window
+ *  names the notice, so one notice stands for that window instead of one per
+ *  request. */
+function chatGptQuotaState(availability: ProviderAvailability): QuotaState {
+  const primary = availability.chatGptQuota().primary;
+  if (primary === undefined || primary.usedPercent < 100) return UNMETERED;
+  const resetsAtMs = primary.resetsAtSeconds === undefined ? undefined : primary.resetsAtSeconds * 1000;
+  const window = primary.resetsAtSeconds === undefined ? "current" : String(primary.resetsAtSeconds);
+  const reset = resetsAtMs === undefined ? "" : ` The window resets at ${new Date(resetsAtMs).toISOString()}.`;
+  return { available: false, window, detail: `The ChatGPT usage limit for this window is reached.${reset}` };
+}
+
+/** One notice per {session, provider, exhaustion window}: the notice id carries
+ *  all three, so the existing upsert path collapses repeats within the window
+ *  and the scope retires the notice once the provider serves again. */
+function notifyQuota(
+  deps: ProviderChainDeps,
+  provider: AccessProviderId,
+  state: QuotaState,
+  fallback: AccessProviderId,
+  failureMessage?: string,
+): void {
+  const scope = deps.sessionId
+    ? `provider-quota:${deps.sessionId}:${provider}`
+    : `provider-quota:${provider}`;
+  const detail = state.detail || failureMessage || `${accessProviderShortName(provider)} cannot serve this request.`;
+  deps.onNotice?.({
+    type: "upsert",
+    notice: {
+      id: `${scope}:${state.window}`,
+      scope,
+      kind: "transient",
+      severity: "warning",
+      title: `${accessProviderShortName(provider)} quota exhausted`,
+      message: `${detail} Sending this request through ${accessProviderDisplayName(fallback)} instead.`,
+    },
+  });
+}
+
+function resolveQuotaNotice(deps: ProviderChainDeps, provider: AccessProviderId): void {
+  const scope = deps.sessionId
+    ? `provider-quota:${deps.sessionId}:${provider}`
+    : `provider-quota:${provider}`;
+  deps.onNotice?.({ type: "resolve-scope", scope });
+}
+
+function exhaustedChainError(model: string, skipped: readonly SkippedCandidate[]): ApiError {
+  const reasons = skipped
+    .map((candidate) => `${accessProviderShortName(candidate.provider)}: ${candidate.state.detail}`)
+    .join(" ");
+  return new ApiError({ message: `No access provider can run "${model}" right now. ${reasons}`.trim() });
+}
