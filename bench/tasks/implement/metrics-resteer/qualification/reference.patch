--- /dev/null
+++ b/store.ts
@@ -0,0 +1,15 @@
+import type { Rollup } from "./types.js";
+
+export class MetricsStore {
+  private readonly byMetric = new Map<string, Rollup[]>();
+
+  append(rollup: Rollup): void {
+    const retained = this.byMetric.get(rollup.metric);
+    if (retained) retained.push(rollup);
+    else this.byMetric.set(rollup.metric, [rollup]);
+  }
+
+  read(metric: string): readonly Rollup[] {
+    return this.byMetric.get(metric) ?? [];
+  }
+}
