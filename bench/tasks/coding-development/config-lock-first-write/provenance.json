  "tests": [
    {
      "origin": "bench/chat-ab/tasks/config-lock-first-write/acceptance/config-ownership.test.ts",
      "originSha256": "e3ee8ce9eeb1eebd6e6dd0d8f3dfafb3fff2c7a7742bfa66c2ad66db702e2bf1",
      "destination": "acceptance/config-ownership.test.ts",
      "adaptations": [
        "Replace the historical temporaryDirectories helper with native per-test cleanup.",
        "Catch lock refusal as an observed outcome so original bugs fail behavioral assertions.",
        "Add native held-lock asynchronous release coverage through the existing acquireLockSyncIn and releaseLockIn entry points.",
        "Extend that held-lock test with a spy that delegates the real ContainedDirectory.linkFile operation and queues one synchronous sibling write after successful lock publication following timer release. Require the waiting callback to capture empty text and the sibling write to succeed with exact readback.",
        "A focused native publication-ordering probe reproduced reference success and the former alternative's sibling lock refusal. This proves the module's no-yield-after-acquisition contract, not ordinary UI reachability or a full-app reproduction."
      ]
    },
    {
      "destination": "config-smoke.test.ts",
      "origin": "fixture-authored visible native synchronous config smoke test in sandbox.patch"
    }
  ],
  "controls": {
    "reference": "Exact production diff for both required files.",
    "alternative": "Add backward-compatible acquireLockIn overloads with an optional synchronous acquired callback. Run config use and release inside every successful acquisition attempt, retaining the single retry ladder.",
    "queuedYieldRegression": "Preserve the former alternative byte for byte and apply it directly to the original. Immediate acquisition succeeds, but contended acquisition yields to a promise continuation while holding the native lock. Only the extended held-lock ordering test fails.",
    "original": "Apply reference then reverse the exact production diff.",
    "swallowedCallback": "Apply reference then swallow callback exceptions while retaining release."
  },
  "environment": {
    "runtime": "bun",
    "version": "1.4.0",
    "platform": "darwin",
    "architecture": "arm64",
    "dependencies": [],
    "dependencyLock": "The closure imports only Bun FFI and built-ins. Bun 1.4.0 deletes an empty lockfile; the zero-dependency package passes bun install --frozen-lockfile without a lockfile.",
    "setup": "bun install --frozen-lockfile"
  },
  "limits": [
    "Same-process synchronous-callback ownership contract only, including native lock publication followed by a queued synchronous sibling. Scheduling instrumentation proves this module invariant, not ordinary UI reachability or full-app reproduction.",
